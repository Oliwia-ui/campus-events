# Optional: copy to .env to override the defaults. Never commit .env.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DB_STORAGE=./data/events.sqlite
# RabbitMQ (assignment part 4). Local: docker compose up -d rabbitmq
# AMQP_URL=amqp://guest:guest@localhost:5672
# AMQP_EXCHANGE=campus-events
# How often the outbox relay looks for mails that still need to go out.
# OUTBOX_INTERVAL_MS=3000

# Confirmation mails. Without SMTP_HOST the mail is only logged, not sent.
# Free test inbox: https://ethereal.email (Create Ethereal Account) gives host, user and password.
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Campus Events <no-reply@campus-events.local>

# Optional future PostgreSQL database. Omit DATABASE_URL for SQLite, including on Render.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
